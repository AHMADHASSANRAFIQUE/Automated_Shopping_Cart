{
  "name": "voice-grocery-list",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/x-date-pickers": "^6.20.2",
    "axios": "^1.16.0",
    "dayjs": "^1.11.18",
    "fuse.js": "^7.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "lucide-react": "^1.14.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/js": "^9.37.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "sharp": "^0.34.4",
    "terser": "^5.44.0",
    "vite": "^4.5.14",
    "vite-plugin-pwa": "^1.1.0",
    "workbox-window": "^7.3.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:ci": "vite build",
    "preview": "vite preview",
    "build:prod": "NODE_ENV=production npm run lint && vite build",
    "build:analyze": "vite build --mode analyze",
    "clean": "rm -rf dist",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist",
    "serve": "vite preview --host --port 4173",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "eslint src --max-warnings 10",
    "lint:backend": "cd ../backend/voice_service && npm run lint",
    "lint:fix": "npm run lint:frontend:fix && npm run lint:backend:fix",
    "lint:frontend:fix": "eslint src --fix",
    "lint:backend:fix": "cd ../backend/voice_service && npm run lint:fix",
    "postinstall": "echo 'Run npm run lint to check for issues'"
  }
}
